{
  "schema_version": "workagent-markdown-training-runtime-v1",
  "model_path": ".runtime/models/generator",
  "pairs_file": ".runtime/training_pairs/reviewed.jsonl",
  "executor_credentials_file": ".runtime/private/gpt-api.env",
  "executor_options": {
    "provider": "openai",
    "model": "gpt-6.1-sol",
    "max_turns": 50,
    "max_output_tokens": 8192,
    "task_timeout": 1800,
    "request_timeout": 180
  },
  "algorithm": {"name": "grpo", "group_size": 4, "normalize_std": true},
  "prompt_batch_size": 2,
  "prompt_length": 32768,
  "response_length": 8192,
  "learning_rate": 0.000001,
  "total_steps": 1,
  "visible_gpus": [0],
  "agent_workers": 2,
  "generator_concurrency_per_worker": 2,
  "executor_concurrency_per_worker": 1,
  "queue_capacity_per_worker": 4,
  "sample_timeout": 600,
  "executor_timeout": 2400
}
