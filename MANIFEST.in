include AGENTS.md CONTRIBUTING.md SOURCE_PROVENANCE.md environment-dev.yml
include LICENSE
recursive-include configs *.json
recursive-include examples *.json *.jsonl
recursive-include doc *.md *.jpg
graft skill_rsi/adapters
graft skill_rsi/components/resources
graft skill_rsi/ui/static
global-exclude .DS_Store *.pyc *.pyo .env .env.*
