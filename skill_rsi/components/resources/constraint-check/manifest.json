{
  "schema": "skill-rsi.component.v1",
  "component_id": "constraint-check",
  "version": "1.0.0",
  "form": "plugin",
  "engine": "python",
  "entrypoint": "payload/policy.py",
  "required_capabilities": {
    "all": ["read_origin"],
    "apply": ["append_context"],
    "suggest": ["suggest"]
  },
  "scope": {
    "hosts": ["dsh", "claude_code", "codex"],
    "modes": ["shadow", "suggest", "apply"]
  },
  "trigger": {"boundaries": ["tool_result", "mcp_tool_result", "before_action", "mcp_before_action", "before_use", "resume"]},
  "action": {"kind": "append_context", "writes": ["context.constraint"]},
  "state_version": "1",
  "budget": {
    "max_reads": 1,
    "max_original_bytes": 1048576,
    "max_action_bytes": 8192,
    "max_state_bytes": 131072
  },
  "fallback": "native"
}
