{
  "run_dir": "../runs/workbuddy",
  "sequence": "workbuddy-example",
  "benchmark": {
    "kind": "workbuddy",
    "manifest": "workbuddy-export/tasks.json",
    "images": {"original-task-id": "original-workbuddy-image@sha256:REPLACE_WITH_IMAGE_DIGEST"},
    "network": "your-benchmark-network",
    "user": "1005:1005",
    "security_profile": "hardened",
    "evaluator": {"kind": "command", "argv": ["python3", "/absolute/path/to/your_native_workbuddy_verifier_hook.py"], "timeout": 900}
  },
  "models": {
    "executor": {"base_url": "https://your-gateway.example/v1", "model": "your-executor-model", "api_key_env": "EXECUTOR_API_KEY"},
    "curator": {"base_url": "http://127.0.0.1:8000/v1", "model": "your-skill-manager", "api_key_env": "CURATOR_API_KEY"},
    "judge": {"base_url": "https://your-gateway.example/v1", "model": "your-judge-model", "api_key_env": "JUDGE_API_KEY"}
  },
  "executor": {
    "backend": "claude-code",
    "cli_host_path": "/absolute/path/to/standalone/claude",
    "bridge_bind": "YOUR_PRIVATE_DOCKER_GATEWAY",
    "bridge_advertise": "YOUR_PRIVATE_DOCKER_GATEWAY",
    "max_turns": 64,
    "timeout": 900
  },
  "curator": {"max_turns": 16, "wall_seconds": 900}
}
