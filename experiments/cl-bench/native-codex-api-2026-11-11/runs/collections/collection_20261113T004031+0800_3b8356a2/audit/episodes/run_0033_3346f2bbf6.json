          "content": "SELECT COUNT(*) AS product_count FROM (SELECT i.ref_id FROM items_g1 i JOIN fdbk_g1 f ON f.ref_id = i.ref_id WHERE i.status = 'active' AND f.vrf = 1 GROUP BY i.ref_id HAVING COUNT(*) >= 5 AND AVG(f.rtg) = 5.0);"
