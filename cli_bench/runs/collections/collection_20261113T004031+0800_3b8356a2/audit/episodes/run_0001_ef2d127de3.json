          "content": "WITH ranked AS (SELECT prc_usd, ROW_NUMBER() OVER (ORDER BY prc_usd) AS rn, COUNT(*) OVER () AS n FROM items_g2 WHERE prc_usd != 0) SELECT ROUND(AVG(prc_usd), 2) AS median_price FROM ranked WHERE rn IN ((n + 1) / 2, (n + 2) / 2);"
