      "response": {
        "action": {
          "action": "QUERY",
          "content": "SELECT ROUND(AVG(CASE WHEN f.verified_status IS NULL THEN LENGTH(f.body) END) - AVG(CASE WHEN f.verified_status IS NOT NULL THEN LENGTH(f.body) END), 1) AS difference FROM fdbk_g1 f JOIN items_g1 i ON i.ref_id = f.ref_id WHERE i.status = 'active' AND LENGTH(f.body) > 0;"
