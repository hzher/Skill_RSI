      "response": {
        "action": {
          "action": "QUERY",
          "content": "WITH brands AS MATERIALIZED (SELECT DISTINCT ref_id, attr_val AS brand FROM product_attributes_g3 WHERE attr_key = 'Brand'), reviews AS (SELECT ref_id, COALESCE(CAST(strftime('%Y', ts) AS INTEGER), review_year) AS yr FROM fdbk_g3) SELECT COUNT(*) AS brand_count FROM (SELECT b.brand FROM brands b JOIN reviews f ON f.ref_id = b.ref_id WHERE f.yr IN (2019, 2020, 2021) GROUP BY b.brand HAVING COUNT(DISTINCT f.yr) = 3);"
        },
