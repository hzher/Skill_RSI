      "response": {
        "action": {
          "action": "QUERY",
          "content": "SELECT COUNT(*) AS product_count FROM (SELECT i.ref_id FROM items_g1 i JOIN fdbk_g1 f ON f.ref_id = i.ref_id WHERE i.status = 'active' AND i.prc > 20 GROUP BY i.ref_id HAVING SUM(CASE WHEN COALESCE(f.verified_status, CASE WHEN f.vrf = 1 THEN 'verified' ELSE 'unverified' END) = 'verified' THEN 1 ELSE 0 END) = 0);"
