      "response": {
        "action": {
          "action": "QUERY",
          "content": "SELECT ROUND(100.0 * AVG(CASE WHEN i.prc > (SELECT AVG(prc) FROM items_g3 WHERE prc IS NOT NULL) THEN 1 ELSE 0 END), 1) AS percentage FROM fdbk_g3 f LEFT JOIN items_g3 i ON i.ref_id = f.ref_id WHERE f.ts IS NULL OR TRIM(f.ts) = '';"
